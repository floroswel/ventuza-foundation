<!--
  Fragment de aplicat în `android/app/src/main/AndroidManifest.xml`
  DUPĂ `npx cap add android`.

  1) Adaugă la <manifest ...> namespace-ul `tools`:
       xmlns:tools="http://schemas.android.com/tools"

  2) Adaugă imediat înainte de </manifest> permisiunile de mai jos.
     - REMOVE AD_ID: FCM și RevenueCat îl includ automat în merged manifest,
       dar Suzeta nu folosește advertising ID. Play Data Safety: "No".
     - REMOVE ACCESS_BACKGROUND_LOCATION: geofencing background nu e activ
       încă; când îl activezi, elimină linia și adaugă justificare în
       Play Console + consent `background_location` în app.
-->
<uses-permission android:name="com.google.android.gms.permission.AD_ID"
                 tools:node="remove"/>

<uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
                 tools:node="remove"/>

<!-- Locația foreground este cerută exclusiv după acțiunea explicită a userului. -->
<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

<!-- Android 13+: notificările sunt cerute doar din acțiunea explicită a userului. -->
<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>


<!--
  App Links pentru email confirmation, reset password și revenirea din Didit.
  Se injectează în <activity android:name="...MainActivity"> în build-ul Android.
-->
<intent-filter android:autoVerify="true">
  <action android:name="android.intent.action.VIEW"/>
  <category android:name="android.intent.category.DEFAULT"/>
  <category android:name="android.intent.category.BROWSABLE"/>
  <data android:scheme="https" android:host="suzeta.app"/>
  <data android:scheme="https" android:host="www.suzeta.app"/>
</intent-filter>

<!--
  Widget home-screen (4x1). Se adaugă în interiorul tag-ului <application>.
  Fără permisiuni noi: widget-ul deschide un App Link și un sheet de share.
-->
<receiver android:name="app.suzeta.SuzetaWidgetProvider"
          android:exported="false">
  <intent-filter>
    <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
  </intent-filter>
  <meta-data android:name="android.appwidget.provider"
             android:resource="@xml/widget_suzeta_info"/>
</receiver>
