<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget home-screen Suzeta (4x1).

  Două acțiuni, ambele pornesc din widget, nu din app:
    - „Cine e aproape” → deschide /discover în aplicație
    - „Invită” → sheet nativ de share cu linkul de recomandare
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/widget_title"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_title"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_subtitle"
            android:textColor="#B8B4C4"
            android:textSize="12sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_discover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_action_discover"
        android:textColor="#0B0B10"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/widget_button"/>

    <TextView
        android:id="@+id/widget_invite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/widget_action_invite"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/widget_button_ghost"/>
</LinearLayout>
