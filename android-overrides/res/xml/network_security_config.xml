<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security config Suzeta.

  - Cleartext HTTP INTERZIS global (inclusiv pe suzeta.app / suzeta.ro).
  - Certificate pinning DEZACTIVAT intenționat.
    Motiv: hosting-ul este în spatele unui CDN care rotește CA-ul emitent
    (Google Trust Services / Cloudflare). Un pin învechit face ca TOATE
    cererile HTTPS să eșueze pe telefoanele deja actualizate din Play —
    aplicația pare că „se deschide și se închide”, fără nicio cale de
    remediere fără un release nou. Riscul MITM real este acoperit de
    validarea normală a lanțului cu trust store-ul de sistem + HSTS.
    Dacă se reintroduce pinning, se pinează DOI pini (curent + backup) și
    se setează `expiration` la maxim 6 luni, cu proces de rotație verificat
    în CI înainte de fiecare release.
  - debug-overrides permite CA-uri user doar în build-urile debug (proxy local).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">suzeta.app</domain>
        <domain includeSubdomains="true">suzeta.ro</domain>
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
