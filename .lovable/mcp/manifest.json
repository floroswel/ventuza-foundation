{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://szzxhvvmwqvfyoldcuyz.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "suzeta-mcp",
      "version": "0.1.0",
      "title": "Suzeta"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Cine sunt",
        "description": "Returnează informații de bază despre profilul utilizatorului autentificat (display name, username, oraș, plan).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "unread_counts",
        "title": "Necitite",
        "description": "Numărul de mesaje și notificări necitite pentru utilizatorul autentificat.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "recent_notifications",
        "title": "Notificări recente",
        "description": "Ultimele notificări (tip, titlu, timp, citit/necitit) pentru utilizatorul autentificat.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Câte notificări (1-50). Default 10."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "mark_notifications_read",
        "title": "Marchează notificări citite",
        "description": "Marchează notificările utilizatorului ca fiind citite. Dacă `ids` este furnizat, doar acele notificări; altfel toate cele necitite.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 200,
              "description": "Listă de UUID-uri de notificări. Omite pentru a marca toate necitite."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "send_tap",
        "title": "Trimite tap",
        "description": "Trimite un tap (emoji reaction) către un alt utilizator Suzeta. Respectă blocările și preferințele destinatarului la nivel de DB.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "receiver_id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID-ul userului destinatar."
            },
            "emoji": {
              "type": "string",
              "enum": [
                "👋",
                "🔥",
                "😈",
                "👀",
                "💋",
                "🍆"
              ],
              "description": "Emoji tap: 👋 🔥 😈 👀 💋 🍆"
            }
          },
          "required": [
            "receiver_id",
            "emoji"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_conversations",
        "title": "Conversații recente",
        "description": "Listă cu conversațiile utilizatorului (id, celălalt participant, ultimul mesaj, timp, câte necitite). Nu returnează conținutul brut al mesajelor — doar metadata.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Câte conversații (1-50). Default 20."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
